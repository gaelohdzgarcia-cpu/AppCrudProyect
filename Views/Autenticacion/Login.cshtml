@model AppCrud.ViewModels.LoginVm

@{
    Layout = "~/Views/Autenticacion/_Layout.cshtml";
}
<div class="container">
    <div class="row justify-content-center">

        <div class="col-12 col-sm-10 col-md-6 col-lg-4">

            <div class="card shadow-sm mt-5">
                <div class="card-body">

                    <h2 class="text-center mb-4">
                        Iniciar Sesión
                    </h2>

                    <form asp-controller="Autenticacion"
                          asp-action="Login"
                          method="post">

                        <div class="mb-3">
                            <label class="form-label">
                                Correo
                            </label>

                            <input class="form-control"
                                   asp-for="Correo"
                                   type="email"
                                   placeholder="Correo" />
                            <span asp-validation-for="Correo"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Contraseña
                            </label>

                            <input class="form-control"
                                   asp-for="Clave"
                                   type="password"
                                   placeholder="Contraseña" />
                            <span asp-validation-for="Clave"
                                  class="text-danger">
                            </span>
                        </div>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">
                                @ViewBag.Error
                            </div>
                        }

                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-primary">
                                Iniciar Sesión
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>

    </div>
</div>